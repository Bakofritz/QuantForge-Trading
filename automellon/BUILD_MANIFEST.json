{
  "schema": "automellon-build-manifest/v1",
  "protocol_version": "1.1",
  "program": "QuantForge",
  "canonical_repository": "Bakofritz/QuantForge-Trading",
  "development_branch": "master/v30.00-phase5-production-hardening",
  "iteration_checkpoint": 15,
  "authority": {
    "simulation_only": true,
    "live_trading": false,
    "broker_orders": false,
    "merge_protected_main": false,
    "force_push": false
  },
  "execution": {
    "fail_closed": true,
    "arbitrary_shell": false,
    "max_log_tail_lines": 80,
    "result_file": "AUTOMELLON_RESULT.json",
    "artifact_retention_days": 30
  },
  "phases": [
    {
      "id": "01-audit",
      "description": "Confirm repository state before build operations.",
      "commands": [
        "git_status"
      ],
      "stable_checkpoint": false
    },
    {
      "id": "02-static-validation",
      "description": "Run deterministic repository and packaging gates.",
      "commands": [
        "static_validate",
        "package_source_test"
      ],
      "stable_checkpoint": true
    },
    {
      "id": "03-native-environment",
      "description": "Record native SDK availability.",
      "commands": [
        "dotnet_info"
      ],
      "stable_checkpoint": false
    },
    {
      "id": "04-native-restore-test",
      "description": "Restore and run Release native tests.",
      "commands": [
        "dotnet_restore",
        "dotnet_test"
      ],
      "stable_checkpoint": true
    }
  ],
  "pause_rules": {
    "on_any_nonzero_exit": true,
    "on_unknown_command": true,
    "on_authority_violation": true,
    "on_protected_branch": true,
    "at_stable_checkpoint": false
  },
  "reporting": {
    "compact_json": true,
    "full_logs_as_github_artifact": true,
    "chat_file_uploads_required": false,
    "github_is_canonical": true
  },
  "checkpoints": {
    "lightweight_interval": 5,
    "integrity_interval": 15,
    "integrity_requirements": [
      "repository_structure_and_required_documentation",
      "static_architecture_and_package_source_validation",
      "core_and_native_test_pipeline_status",
      "android_and_windows_build_pipeline_status",
      "source_and_artifact_provenance",
      "authority_and_simulation_only_boundaries",
      "version_and_manifest_consistency",
      "pipeline_and_handoff_continuity"
    ],
    "progress_report": true,
    "owner_review_report_on_retention_candidates": true
  },
  "format_contract": {
    "preserve_original_mellon_structure": true,
    "preserve_original_documentation_requirements": true,
    "required_on_every_saved_keyframe": [
      "README.md",
      "AGENT_START_HERE.md",
      "CURRENT_STATE.json",
      "SOURCE_MANIFEST.json",
      "guides/01-07",
      "build_and_iteration_history",
      "validation_evidence",
      "handoff_and_startup_instructions",
      "native_android_and_windows_status",
      "candidate_vs_stable_status",
      "authority_boundary_notes"
    ],
    "format_changes_require_owner_approval": true
  },
  "retention": {
    "mode": "keyframe",
    "save_every_iteration_as_git_commit": true,
    "designate_keyframes_for_milestones_and_material_changes": true,
    "deletion_automation": false,
    "pruning_automation": false,
    "history_rewrite_automation": false,
    "checkpoint_report_lists_retention_candidates": true,
    "owner_decides_retention_actions": true,
    "chat_upload_checkpoint_documentation_only": true,
    "compiled_android_or_pc_chat_artifact_only_when_owner_input_required": true
  }
}
