<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>QuantForge.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationTitle>QuantForge Test</ApplicationTitle>
    <ApplicationId>com.quantforge.diagnostic</ApplicationId>
    <ApplicationDisplayVersion>0.30.6</ApplicationDisplayVersion>
    <ApplicationVersion>3006</ApplicationVersion>
    <InformationalVersion>0.30.6-diagnostic+$(SourceRevisionId)</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#1B1B1B" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#1B1B1B" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../QuantForge.Core/QuantForge.Core.csproj" />
  </ItemGroup>
</Project>
